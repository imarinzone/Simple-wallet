<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Material 3 Expressive frameless dual-card emblem, optically centered
        with generous breathing room inside the 66dp safe zone for all Android 16
        expressive shapes (Circle, Squircle, 4/7-sided Cookie, Arch, Clover) and parallax.
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.85"
        android:scaleY="0.85"
        android:translateY="0.6">

        <!-- Back Stacked Card (Warm Expressive Gold peeking behind front card) -->
        <path android:pathData="M38.5,31 H69.5 A5.5,5.5 0 0,1 75,36.5 V48 A3,3 0 0,1 72,51 H36 A3,3 0 0,1 33,48 V36.5 A5.5,5.5 0 0,1 38.5,31 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="75"
                    android:endY="48"
                    android:startX="33"
                    android:startY="31"
                    android:type="linear">
                    <item
                        android:color="#FDE047"
                        android:offset="0.0" />
                    <item
                        android:color="#F59E0B"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Subtle Separation Shadow Between Back Card and Front Card -->
        <path
            android:fillAlpha="0.16"
            android:fillColor="#0F172A"
            android:pathData="M33,39.5 H75 V43 H33 Z" />

        <!-- Primary Front Card Body (Luminous Crisp White-to-Ice Card) -->
        <path android:pathData="M33.5,41.5 H74.5 A6.5,6.5 0 0,1 81,48 V69 A6.5,6.5 0 0,1 74.5,75.5 H33.5 A6.5,6.5 0 0,1 27,69 V48 A6.5,6.5 0 0,1 33.5,41.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="81"
                    android:endY="75.5"
                    android:startX="27"
                    android:startY="41.5"
                    android:type="linear">
                    <item
                        android:color="#FFFFFF"
                        android:offset="0.0" />
                    <item
                        android:color="#EFF6FF"
                        android:offset="0.65" />
                    <item
                        android:color="#DBEAFE"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- EMV Smart Chip (Bold Rounded Pill with Warm Metallic Gold Gradient) -->
        <path android:pathData="M36.2,48.5 H42.8 A2.2,2.2 0 0,1 45,50.7 V54.3 A2.2,2.2 0 0,1 42.8,56.5 H36.2 A2.2,2.2 0 0,1 34,54.3 V50.7 A2.2,2.2 0 0,1 36.2,48.5 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:endX="45"
                    android:endY="56.5"
                    android:startX="34"
                    android:startY="48.5"
                    android:type="linear">
                    <item
                        android:color="#FCD34D"
                        android:offset="0.0" />
                    <item
                        android:color="#D97706"
                        android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- EMV Chip Contact Lines -->
        <path
            android:pathData="M39.5,48.5 V56.5 M34,52.5 H45"
            android:strokeAlpha="0.5"
            android:strokeColor="#78350F"
            android:strokeWidth="0.85" />

        <!-- Contactless NFC Waves (Bold Expressive Cobalt Arcs) -->
        <path
            android:fillColor="#2563EB"
            android:pathData="M67.13,47.78 A7.35,7.35 0 0,1 67.13,57.22 A1.15,1.15 0 0,1 65.37,55.75 A5.05,5.05 0 0,0 65.37,49.25 A1.15,1.15 0 0,1 67.13,47.78 Z" />
        <path
            android:fillColor="#3B82F6"
            android:pathData="M70.50,44.95 A11.75,11.75 0 0,1 70.50,60.05 A1.15,1.15 0 0,1 68.74,58.57 A9.45,9.45 0 0,0 68.74,46.43 A1.15,1.15 0 0,1 70.50,44.95 Z" />

        <!-- Card Number Accent Pill Bar -->
        <path
            android:fillColor="#1E40AF"
            android:pathData="M36.1,64.5 H54.4 A2.1,2.1 0 0,1 56.5,66.6 A2.1,2.1 0 0,1 54.4,68.7 H36.1 A2.1,2.1 0 0,1 34,66.6 A2.1,2.1 0 0,1 36.1,64.5 Z" />

        <!-- Payment Network Overlapping Discs -->
        <path
            android:fillColor="#EF4444"
            android:pathData="M66.8,66.6 m-3.4,0 a3.4,3.4 0 1,0 6.8,0 a3.4,3.4 0 1,0 -6.8,0" />
        <path
            android:fillAlpha="0.92"
            android:fillColor="#F59E0B"
            android:pathData="M71.0,66.6 m-3.4,0 a3.4,3.4 0 1,0 6.8,0 a3.4,3.4 0 1,0 -6.8,0" />
    </group>
</vector>
